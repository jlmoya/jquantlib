<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Standalone Spring Boot application that showcases the JQuantLib library.
      Its parent is the Spring Boot starter parent (NOT the jquantlib reactor), so
      building this project never pulls Spring Boot into the library build. It
      consumes jquantlib as an ordinary Maven artifact from the local repository.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.jquantlib</groupId>
    <artifactId>jquantlib-showcase</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>jquantlib-showcase</name>
    <description>Interactive Spring Boot showcase of the JQuantLib quantitative-finance library</description>

    <properties>
        <java.version>25</java.version>
        <jquantlib.version>1.0.0</jquantlib.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- The library under showcase. -->
        <dependency>
            <groupId>org.jquantlib</groupId>
            <artifactId>jquantlib</artifactId>
            <version>${jquantlib.version}</version>
        </dependency>

        <!-- The bundled example programs, surfaced live in the "Sample Programs" demo. -->
        <dependency>
            <groupId>org.jquantlib</groupId>
            <artifactId>jquantlib-samples</artifactId>
            <version>${jquantlib.version}</version>
        </dependency>

        <!-- Discrete-dividend option helpers (CRR/FD American & European), used by the Dividend Options demo. -->
        <dependency>
            <groupId>org.jquantlib</groupId>
            <artifactId>jquantlib-helpers</artifactId>
            <version>${jquantlib.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
