<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Standalone Spring Boot application that showcases the JQuantLib library.
      Its parent is the Spring Boot starter parent (NOT the jquantlib reactor), so
      building this project never pulls Spring Boot into the library build. It
      consumes jquantlib as an ordinary Maven artifact from the local repository.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>cc.sosonline.jquantlib</groupId>
    <artifactId>jquantlib-showcase</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>jquantlib-showcase</name>
    <description>Interactive Spring Boot showcase of the JQuantLib quantitative-finance library</description>

    <properties>
        <java.version>25</java.version>
        <!-- The core library version: first three segments = the C++ QuantLib release it
             targets (1.42.1); fourth = the Java-port revision. Keep in sync with
             jquantlib/pom.xml and the reactor parent's jquantlib.version. -->
        <jquantlib.version>1.42.1.1</jquantlib.version>
        <!-- The companion modules (samples, helpers) track the reactor version (1.0.0). -->
        <jquantlib.companion.version>1.0.0</jquantlib.companion.version>
        <!--
          The reactor parent defines nexus.base.url, but this module's parent is the
          Spring Boot starter, so it inherits nothing from the reactor. Redeclare it
          here so the distributionManagement URLs below resolve.
        -->
        <nexus.base.url>http://localhost:7910/repository</nexus.base.url>
    </properties>

    <!--
      This module's parent is the Spring Boot starter (not the jquantlib reactor),
      so it does not inherit the reactor's distributionManagement. Mirror the reactor's
      Nexus targets here, reusing the same server ids (nexus-releases / nexus-snapshots,
      defined in ~/.m2/settings.xml) so a reactor-wide `mvn deploy` publishes the
      showcase alongside the library modules.
    -->
    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <url>${nexus.base.url}/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <url>${nexus.base.url}/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- The library under showcase. -->
        <dependency>
            <groupId>cc.sosonline.jquantlib</groupId>
            <artifactId>jquantlib</artifactId>
            <version>${jquantlib.version}</version>
        </dependency>

        <!-- The bundled example programs, surfaced live in the "Sample Programs" demo. -->
        <dependency>
            <groupId>cc.sosonline.jquantlib</groupId>
            <artifactId>jquantlib-samples</artifactId>
            <version>${jquantlib.companion.version}</version>
        </dependency>

        <!-- Discrete-dividend option helpers (CRR/FD American & European), used by the Dividend Options demo. -->
        <dependency>
            <groupId>cc.sosonline.jquantlib</groupId>
            <artifactId>jquantlib-helpers</artifactId>
            <version>${jquantlib.companion.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
