+package org.jquantlib.math.matrixutilities;
+
+/**
+ * Householder transformation {@code H = I - 2 v v^T / (v^T v)}.
+ *
+ * <p>Java port of QuantLib v1.42.1
+ * {@code ql/math/matrixutilities/householder.hpp,cpp}.
+ *
+ * <p>Reference: <a
+ * href="https://en.wikipedia.org/wiki/Householder_transformation">Wikipedia</a>.
+ */
+public class HouseholderTransformation {
+
+    private final Array v;
+
+    public HouseholderTransformation(final Array v) {
+        this.v = v;
+    }
+
+    /**
+     * Apply the transformation to {@code x}, returning {@code x - 2 (v . x) v}.
+     * Mirrors C++ {@code operator()(const Array& x) const}.
+     */
+    public Array apply(final Array x) {
+        final double dot = v.dotProduct(x);
+        return x.sub(v.mul(2.0 * dot));
+    }
+
+    /**
+     * Return the dense matrix representation {@code H = I - 2 y y^T} where
+     * {@code y = v / ||v||}. Mirrors C++ {@code getMatrix()}.
+     */
+    public Matrix getMatrix() {
+        final double norm2 = Math.sqrt(v.dotProduct(v));
+        final int n = v.size();
+        final double[] y = new double[n];
+        for (int i = 0; i < n; ++i) {
+            y[i] = v.get(i) / norm2;
+        }
+        final Matrix m = new Matrix(n, n);
+        for (int i = 0; i < n; ++i) {
+            for (int j = 0; j < n; ++j) {
+                m.set(i, j, ((i == j) ? 1.0 : 0.0) - 2.0 * y[i] * y[j]);
+            }
+        }
+        return m;
+    }
+}
