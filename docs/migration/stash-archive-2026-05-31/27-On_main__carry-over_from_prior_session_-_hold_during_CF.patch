+                assertEquals("amount mismatch", expected, amount, 1.0e-8);
+            } finally {
+                // Best-effort cleanup; the global IndexManager state
+                // would otherwise leak between tests.
+                try {
+                    index.clearFixings();
+                } catch (final Throwable ignored) {
+                    // some indexes / managers may not expose clear; ignore.
+                }
+            }
+        } finally {
+            settings.setEvaluationDate(savedEval);
+        }
+    }
