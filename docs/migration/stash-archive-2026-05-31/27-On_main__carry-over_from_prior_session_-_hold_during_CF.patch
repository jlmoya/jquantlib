+package org.jquantlib.pricingengines;
+
+import org.jquantlib.QL;
+import org.jquantlib.instruments.AssetOrNothingPayoff;
+import org.jquantlib.instruments.CashOrNothingPayoff;
+import org.jquantlib.instruments.Option;
+import org.jquantlib.instruments.StrikedTypePayoff;
+import org.jquantlib.math.Constants;
+import org.jquantlib.math.distributions.CumulativeNormalDistribution;
+
+/**
+ * Analytical formula for American exercise with payoff at expiry.
+ *
+ * <p>Java port of QuantLib v1.42.1 {@code AmericanPayoffAtExpiry}
+ * (ql/pricingengines/americanpayoffatexpiry.{hpp,cpp}) — implements both the
+ * knock-in (default) and knock-out branches needed by
+ * {@link org.jquantlib.pricingengines.vanilla.AnalyticDigitalAmericanEngine}
+ * and {@code AnalyticDigitalAmericanKOEngine}.
+ *
+ * <p>Closed-form result:
+ * <pre>
+ *     value = discount * K * (X * N(d1) + Y * N(d2))
+ * </pre>
+ * with sign-flipped {@code d1, d2} and {@code Y} per {@code knock_in} and
+ * Call/Put, exactly mirroring the C++ reference.
+ *
+ * <p>Replaces the original Jose Coll (2009) Java port which only supported
+ * the knock-in case and used a different (but equivalent for that case)
+ * alpha/beta decomposition.
+ *
+ * @author Jose Coll (original 2009 stub)
+ * @author JQuantLib migration (C++ v1.42.1 port, 2026)
+ */
+public class AmericanPayoffAtExpiry {
+
+    private final /* @Real */ double spot;
+    private final /* @DiscountFactor */ double discount;
+    private final /* @DiscountFactor */ double dividendDiscount;
+    private final /* @Variance */ double variance;
+
+    private final /* @Real */ double forward;
+    private final /* @Volatility */ double stdDev;
+
+    private final /* @Real */ double strike;
+    private double K;
+
+    private double mu;
+    private final double log_H_S;
+
+    private double D1, D2;
+    private double cum_d1, cum_d2;
+    private double n_d1, n_d2;
+
+    private final boolean inTheMoney;
+    private double X, Y;
+    private final boolean knock_in;
+
+
+    /**
+     * Knock-in convenience constructor (matches the C++ default).
+     */
+    public AmericanPayoffAtExpiry(
+            final double spot,
+            final double discount,
+            final double dividendDiscount,
+            final double variance,
+            final StrikedTypePayoff strikedTypePayoff) {
+        this(spot, discount, dividendDiscount, variance, strikedTypePayoff, true);
+    }
+
+    public AmericanPayoffAtExpiry(
+            final double spot,
+            final double discount,
+            final double dividendDiscount,
+            final double variance,
+            final StrikedTypePayoff strikedTypePayoff,
+            final boolean knock_in) {
+
+        QL.require(spot > 0.0, "positive spot value required");
+        QL.require(discount > 0.0, "positive discount required");
+        QL.require(dividendDiscount > 0.0, "positive dividend discount required");
+        QL.require(variance >= 0.0, "negative variance not allowed");
+
+        this.spot = spot;
+        this.discount = discount;
+        this.dividendDiscount = dividendDiscount;
+        this.variance = variance;
+        this.knock_in = knock_in;
+        this.stdDev = Math.sqrt(variance);
+
+        final Option.Type type = strikedTypePayoff.optionType();
+        this.strike = strikedTypePayoff.strike();
+        this.forward = spot * dividendDiscount / discount;
+
+        this.mu = Math.log(dividendDiscount / discount) / variance - 0.5;
+
+        // binary cash-or-nothing payoff?
+        if (strikedTypePayoff instanceof CashOrNothingPayoff) {
+            final CashOrNothingPayoff coo = (CashOrNothingPayoff) strikedTypePayoff;
+            this.K = coo.getCashPayoff();
+        }
+
+        // binary asset-or-nothing payoff?
+        if (strikedTypePayoff instanceof AssetOrNothingPayoff) {
+            this.K = this.forward;
+            this.mu += 1.0;
+        }
+
+        this.log_H_S = Math.log(strike / spot);
+        final double log_S_H = Math.log(spot / strike);
+
+        final double eta;
+        final double phi;
+        switch (type) {
+            case Call:
+                if (knock_in) {
+                    // up-and-in cash-(at-expiry)-or-nothing option
+                    eta = -1.0;
+                    phi = 1.0;
+                } else {
+                    // up-and-out cash-(at-expiry)-or-nothing option
+                    eta = -1.0;
+                    phi = -1.0;
+                }
+                break;
+            case Put:
+                if (knock_in) {
+                    // down-and-in cash-(at-expiry)-or-nothing option
+                    eta = 1.0;
+                    phi = -1.0;
+                } else {
+                    // down-and-out cash-(at-expiry)-or-nothing option
+                    eta = 1.0;
+                    phi = 1.0;
+                }
+                break;
+            default:
+                throw new IllegalArgumentException("invalid option type");
+        }
+
+        if (variance >= Constants.QL_EPSILON) {
+            this.D1 = phi * (log_S_H / stdDev + mu * stdDev);
+            this.D2 = eta * (log_H_S / stdDev + mu * stdDev);
+            final CumulativeNormalDistribution f = new CumulativeNormalDistribution();
+            this.cum_d1 = f.op(D1);
+            this.cum_d2 = f.op(D2);
+            this.n_d1 = f.derivative(D1);
+            this.n_d2 = f.derivative(D2);
+        } else {
+            if (log_S_H * phi > 0) {
+                this.cum_d1 = 1.0;
+            } else {
+                this.cum_d1 = 0.0;
+            }
+            if (log_H_S * eta > 0) {
+                this.cum_d2 = 1.0;
+            } else {
+                this.cum_d2 = 0.0;
+            }
+            this.n_d1 = 0.0;
+            this.n_d2 = 0.0;
+        }
+
+        switch (type) {
+            case Call:
+                if (strike <= spot) {
+                    if (knock_in) {
+                        // up-and-in cash-(at-expiry)-or-nothing option
+                        this.cum_d1 = 0.5;
+                        this.cum_d2 = 0.5;
+                    } else {
+                        // up-and-out cash-(at-expiry)-or-nothing option
+                        // already knocked out
+                        this.cum_d1 = 0.0;
+                        this.cum_d2 = 0.0;
+                    }
+                    this.n_d1 = 0.0;
+                    this.n_d2 = 0.0;
+                }
+                break;
+            case Put:
+                if (strike >= spot) {
+                    if (knock_in) {
+                        // down-and-in cash-(at-expiry)-or-nothing option
+                        this.cum_d1 = 0.5;
+                        this.cum_d2 = 0.5;
+                    } else {
+                        // down-and-out cash-(at-expiry)-or-nothing option
+                        // already knocked out
+                        this.cum_d1 = 0.0;
+                        this.cum_d2 = 0.0;
+                    }
+                    this.n_d1 = 0.0;
+                    this.n_d2 = 0.0;
+                }
+                break;
+            default:
+                throw new IllegalArgumentException("invalid option type");
+        }
+
+        this.inTheMoney = (type == Option.Type.Call && strike < spot)
+                || (type == Option.Type.Put && strike > spot);
+        if (inTheMoney) {
+            this.X = 1.0;
+            this.Y = 1.0;
+        } else {
+            this.X = 1.0;
+            if (cum_d2 == 0.0) {
+                this.Y = 0.0; // check needed on some extreme cases
+            } else {
+                this.Y = Math.pow(strike / spot, 2.0 * mu);
+            }
+        }
+        if (!knock_in) {
+            this.Y *= -1.0;
+        }
+    }
+
+    public /* @Real */ double value() {
+        return discount * K * (X * cum_d1 + Y * cum_d2);
+    }
+
+}
