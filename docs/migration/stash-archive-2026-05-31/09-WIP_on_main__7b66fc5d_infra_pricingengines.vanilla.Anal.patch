+                { -1.0,  2.5 }, { -100.0,  0.0 },
+                // right of box
+                {  5.0,  1.5 }, { 1e6, 4.0 },
+                // below box
+                {  2.5, -1.0 }, {  0.0, -100.0 },
+                // above box
+                {  1.5,  5.0 }, {  4.0,  1e6 },
+                // four corners
+                { -1.0, -1.0 }, {  5.0, -1.0 },
+                { -1.0,  5.0 }, {  5.0,  5.0 },
