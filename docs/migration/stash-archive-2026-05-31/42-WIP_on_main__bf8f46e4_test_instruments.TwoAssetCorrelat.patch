+    /**
+     * Sort (eigenvalue, eigenvector) pairs by eigenvalue descending and
+     * normalise the sign of each eigenvector so its first row entry is
+     * non-negative. Mirrors C++
+     * {@code symmetricschurdecomposition.cpp} lines 115-138 (v1.42.1).
+     */
+    private void sortAndSignNormalize() {
+        final int offset = A.offset();
+
+        // Snapshot eigenvalues and eigenvector columns into permutable arrays.
+        final Integer[] perm = new Integer[size];
+        final double[] eigVals = new double[size];
+        for (int i = 0; i < size; i++) {
+            perm[i] = i;
+            eigVals[i] = diag.$[diag.addr.op(i + offset)];
+        }
+
+        // Sort indices so eigenvalues are descending (stable within ties).
+        java.util.Arrays.sort(perm, (a, b) -> Double.compare(eigVals[b], eigVals[a]));
+
+        // Build sorted/sign-normalized eigenvalues + eigenvector columns.
+        final double[] newDiag = new double[size];
+        final double[][] newCols = new double[size][size]; // newCols[col][row]
+        final double maxEv = Math.abs(eigVals[perm[0]]);
+        for (int col = 0; col < size; col++) {
+            final int srcCol = perm[col];
+            final double eigVal = eigVals[srcCol];
+            // Match C++ round-off check: zero-out eigenvalues below
+            // 1e-16 of the largest in magnitude. Note C++ uses
+            // `temp[col].first / maxEv` (signed), Java mirrors verbatim.
+            if (maxEv > 0.0 && Math.abs(eigVal / maxEv) < 1e-16) {
+                newDiag[col] = 0.0;
+            } else {
+                newDiag[col] = eigVal;
+            }
+            // Read the source column from A (eigenvectors are stored as columns).
+            final double firstRow = A.$[A.addr.op(offset, srcCol + offset)];
+            final double sign = (firstRow < 0.0) ? -1.0 : 1.0;
+            for (int row = 0; row < size; row++) {
+                newCols[col][row] = sign * A.$[A.addr.op(row + offset, srcCol + offset)];
+            }
+        }
+
+        // Write back sorted+sign-normalized eigenvalues and eigenvectors.
+        for (int col = 0; col < size; col++) {
+            diag.$[diag.addr.op(col + offset)] = newDiag[col];
+            for (int row = 0; row < size; row++) {
+                A.$[A.addr.op(row + offset, col + offset)] = newCols[col][row];
+            }
+        }
     }
 
